{
  "name": "@ash-technologia/fathom",
  "version": "0.1.0",
  "description": "Local-first repository intelligence CLI. Know what's beneath the surface.",
  "keywords": [
    "repository",
    "analysis",
    "security",
    "developer-tool",
    "cli",
    "code-quality",
    "git",
    "health-score"
  ],
  "homepage": "https://github.com/Ash-Technologia/Fathom#readme",
  "bugs": {
    "url": "https://github.com/Ash-Technologia/Fathom/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ash-Technologia/Fathom.git"
  },
  "license": "MIT",
  "author": "Fathom Contributors",
  "type": "module",
  "main": "./dist/cli/index.js",
  "bin": {
    "fathom": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "build:watch": "tsc --project tsconfig.json --watch",
    "clean": "node scripts/clean.js",
    "dev": "npm run build && node dist/cli/index.js",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "lint:fix": "eslint --fix \"src/**/*.ts\" \"tests/**/*.ts\"",
    "prepublishOnly": "npm run build && npm test",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "fast-glob": "^3.3.2",
    "ora": "^8.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.11.1",
    "@types/node": "^22.7.4",
    "@vitest/coverage-v8": "^2.1.1",
    "eslint": "^9.11.1",
    "prettier": "^3.3.3",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.7.0",
    "vitest": "^2.1.1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
